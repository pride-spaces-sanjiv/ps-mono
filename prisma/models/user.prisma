model User {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    name         String
    email        String
    password     String?
    isGoogleAcc  Boolean  @default(false)
    organization String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model Provider {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    name         String
    email        String
    password     String?
    isGoogleAcc  Boolean  @default(false)
    organization String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

enum AdminLevel {
    SUPERADMIN
    ADMIN
    SUPPORT
}

model Admin {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    email       String
    password    String?
    isGoogleAcc Boolean    @default(false)
    role        AdminLevel @default(SUPPORT)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
}
