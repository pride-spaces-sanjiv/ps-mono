{
  "name": "pride-spaces-one",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:crm-fr": "turbo run build --filter=ps-crm",
    "build:admin-fr": "turbo run build --filter=admin-fr",
    "build:backend": "turbo run build --filter=backend",
    "build:util-backend": "turbo run build --filter=@pride-spaces/backend",
    "build:util-common": "turbo run build --filter=@pride-spaces/common",
    "build:util-frontend": "turbo run build --filter=@pride-spaces/frontend",
    "dev": "turbo run dev",
    "dev:local": "turbo run dev:local",
    "start": "turbo run start"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  }
}
